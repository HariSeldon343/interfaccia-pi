{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interfaccia pi",
  "version": "2.9.0",
  "identifier": "it.amodeo.interfaccia-pi",
  "build": {
    "frontendDist": "../app/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Interfaccia pi",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "center": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:4666; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; connect-src 'self' http://localhost:4666 ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Antonio Amodeo",
    "copyright": "Antonio Amodeo",
    "category": "DeveloperTool",
    "shortDescription": "Interfaccia grafica completa per l'agente pi",
    "longDescription": "Interfaccia accessibile e autocontenuta per usare pi con il mouse: include Node.js, PI, npm e gli strumenti di ricerca, con sessioni indipendenti anche nella stessa cartella, conversazioni salvate e progettazione guidata dei sistemi di gestione.",
    "resources": {
      "../app/server.mjs": "app/server.mjs",
      "../package.json": "package.json",
      "../app/versione-host.mjs": "app/versione-host.mjs",
      "../app/sistema-guidato-manager.mjs": "app/sistema-guidato-manager.mjs",
      "../app/no-workspace-guard.mjs": "app/no-workspace-guard.mjs",
      "../app/libreria.mjs": "app/libreria.mjs",
      "../app/estrazione.mjs": "app/estrazione.mjs",
      "../app/estrazione-worker.mjs": "app/estrazione-worker.mjs",
      "../app/estrazione-runtime.mjs": "app/estrazione-runtime.mjs",
      "../app/persistenza-atomica.mjs": "app/persistenza-atomica.mjs",
      "../app/consiglio.mjs": "app/consiglio.mjs",
      "../app/consiglio-store.mjs": "app/consiglio-store.mjs",
      "../app/consiglio-ruoli.mjs": "app/consiglio-ruoli.mjs",
      "../app/consiglio-preimpostazioni.mjs": "app/consiglio-preimpostazioni.mjs",
      "../app/consiglio-scrittore.mjs": "app/consiglio-scrittore.mjs",
      "../app/consiglio-guard.mjs": "app/consiglio-guard.mjs",
      "../app/consiglio-controlli.mjs": "app/consiglio-controlli.mjs",
      "../vendor/sistema-guidato": "app/sistema-guidato",
      "../vendor/estrazione": "app/estrazione",
      "../app/public/index.html": "app/public/index.html",
      "../app/public/stile.css": "app/public/stile.css",
      "../app/public/auth-flow-core.js": "app/public/auth-flow-core.js",
      "../app/public/palette-core.js": "app/public/palette-core.js",
      "../app/public/link-core.js": "app/public/link-core.js",
      "../app/public/clipboard-core.js": "app/public/clipboard-core.js",
      "../app/public/attachment-core.js": "app/public/attachment-core.js",
      "../app/public/library-core.js": "app/public/library-core.js",
      "../app/public/view-core.js": "app/public/view-core.js",
      "../app/public/consiglio-core.js": "app/public/consiglio-core.js",
      "../app/public/agenti-core.js": "app/public/agenti-core.js",
      "../app/public/updater-core.js": "app/public/updater-core.js",
      "../app/public/startup-core.js": "app/public/startup-core.js",
      "../app/public/app.js": "app/public/app.js",
      "../vendor/pi-runtime/node": "runtime/node",
      "../vendor/pi-runtime/pi": "runtime/pi",
      "../vendor/pi-runtime/tools": "runtime/tools",
      "../vendor/pi-runtime/manifest.json": "runtime/manifest.json",
      "../vendor/pi-runtime/THIRD-PARTY-NOTICES.txt": "runtime/THIRD-PARTY-NOTICES.txt",
      "../licenses": "licenses",
      "../app/estensioni-manifest.mjs": "app/estensioni-manifest.mjs",
      "../app/estensioni-store.mjs": "app/estensioni-store.mjs",
      "../app/estensioni-manager.mjs": "app/estensioni-manager.mjs",
      "../app/estensioni-chiavi.mjs": "app/estensioni-chiavi.mjs",
      "../app/estensioni-risorse.mjs": "app/estensioni-risorse.mjs",
      "../app/public/estensioni-core.js": "app/public/estensioni-core.js"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
